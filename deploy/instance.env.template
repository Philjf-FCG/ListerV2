# Lister instance @NAME@ - created by provision-instance.sh. Mode 0600, owned by the instance user.
# Ollama runs on this same box.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=gemma4:12b

# This user's Vinted data export (listings/index.html + listings/photos/<item id>/...)
LOCAL_PHOTO_ROOTS=
VINTED_PHOTOS_DIR=/srv/lister/@NAME@/vinted/listings/photos

DATABASE_PATH=./lister.db

# Google Photos picker and eBay: the same developer app can serve every user; each user signs
# in separately and gets their own token files. The redirect URIs stay on http://localhost:8010
# because Google only accepts localhost or https - see deploy/README.md ("Signing in").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_LOCATION_POSTAL_CODE=
EBAY_LOCATION_COUNTRY=GB

EXTENSION_ORIGIN=*

# HTTP Basic credentials for the web UI and the browser extension. The app holds this user's
# eBay/Google tokens and is reachable from the whole LAN, so never leave the password empty.
ACCESS_USER=lister
ACCESS_PASSWORD=@PASSWORD@
