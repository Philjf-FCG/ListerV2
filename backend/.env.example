# Ollama host running your models (gemma4, qwen etc.)
OLLAMA_BASE_URL=http://192.168.1.37:11434
OLLAMA_VISION_MODEL=gemma4:12b

# Local photo library root(s) to scan, semicolon separated
LOCAL_PHOTO_ROOTS=C:\Users\philj\Pictures

# SQLite DB file location (relative to backend/ unless absolute)
DATABASE_PATH=./lister.db

# Google Photos OAuth (create credentials in Google Cloud Console,
# enable "Photos Picker API", add http://localhost:8010/auth/google/callback
# as an authorized redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8010/auth/google/callback

# eBay Sell API (Production). Create an app at developer.ebay.com > Application
# Keys, and an RuName ("Redirect URL name") with its Auth Accepted URL set to
# http://localhost:8010/auth/ebay/callback
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_MARKETPLACE_ID=EBAY_GB
# Only needed if your eBay account has no inventory location yet (one-time setup)
EBAY_LOCATION_POSTAL_CODE=
EBAY_LOCATION_COUNTRY=GB

# CORS origin for the browser extension (chrome-extension://<id> once loaded)
EXTENSION_ORIGIN=*
